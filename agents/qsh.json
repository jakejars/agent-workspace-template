{
  "about": "Agent Workspace Template contract for qsh (read by qsh's workspace plugin). What only takes rights away (locks, the pinned Rules) applies at once; the gate and the hooks run once the person types /workspace trust in this project. Written by bin/workspace (init, upgrade); replaced on upgrade.",
  "schema": 2,
  "hook_env": {
    "AGENT_HARNESS": "qsh",
    "RULES_PINNED": "1"
  },
  "hooks": {
    "session_start": "scripts/hooks/session-start.sh",
    "before_tool": "scripts/hooks/before-tool.sh",
    "after_edit": "scripts/hooks/after-edit.sh"
  },
  "gate": {
    "checks": [
      {
        "name": "gate",
        "run": "scripts/check.sh --json"
      }
    ],
    "unchanged": {
      "ignore": [
        "build-notes/"
      ]
    }
  },
  "blocked": {
    "file": "build-notes/task.md",
    "reason_section": "Open or risky"
  },
  "notes": {
    "file": "build-notes/task.md",
    "ignore": [
      "build-notes/"
    ]
  },
  "locked_paths": [
    "scripts/*.sh",
    "scripts/hooks/**",
    "scripts/TEMPLATE_VERSION",
    ".githooks/**",
    "scripts/local/limits.env",
    "scripts/ceilings.json",
    ".qsh/workspace.json"
  ],
  "harness_owned": [
    ".harness/**"
  ],
  "append_only_once_committed": [
    "memory/log/"
  ],
  "review_on_change": [
    "scripts/local/checks.sh"
  ],
  "pinned_rules": {
    "file": "AGENTS.md",
    "section": "Rules"
  },
  "docs": {
    "dir": "docs"
  }
}
