{
  "_readme": [
    "Optional Claude Code adapter. Neutral lifecycle.py commands own behavior; other runtimes call the same commands.",
    "Merge into project settings without overwriting existing hooks. Settings existence is not proof an event fired; inspect lifecycle.py status.",
    "SessionStart validates and routes; UserPromptSubmit suggests cues; PostToolUse marks dirty; Stop validates changed source. No full graph scan on each write.",
    "PreCompact and SessionEnd refresh evidence only; they cannot reconstruct task meaning. Update the task checkpoint during meaningful work."
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|NotebookEdit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/shim.py\" journal_guard"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/shim.py\" lifecycle",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/shim.py\" lifecycle",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/shim.py\" lifecycle",
            "timeout": 30
          }
        ],
        "matcher": "Edit|MultiEdit|NotebookEdit|Write|Bash|mcp__.*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/shim.py\" lifecycle",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/shim.py\" lifecycle",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/shim.py\" lifecycle",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
